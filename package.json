{
  "name": "docmark",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "pnpm test:unit && pnpm test:e2e",
    "test:unit": "vitest run",
    "test:unit:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:dev": "playwright test --config playwright.dev.config.ts",
    "test:vinext:dev": "node scripts/check-vinext-dev.mjs",
    "test:vinext:prod": "node scripts/check-vinext-dev.mjs prod",
    "pdf:poc": "node scripts/run-pdf-poc.mjs",
    "pdf:poc:collect": "node tests/pdf-poc/collect-artifacts.mjs",
    "pdf:poc:all": "pnpm pdf:poc && pnpm pdf:poc:collect",
    "dev:vinext": "vite dev --port 3001",
    "build:vinext": "vite build",
    "build:dev": "node scripts/environment-command.mjs dev build",
    "build:prod": "node scripts/environment-command.mjs prod build",
    "deploy:dev": "node scripts/environment-command.mjs dev deploy",
    "deploy:prod": "node scripts/environment-command.mjs prod deploy",
    "start:vinext": "vite preview",
    "deploy:vinext": "node scripts/environment-command.mjs prod deploy"
  },
  "dependencies": {
    "@codemirror/commands": "^6.11.1",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.12.4",
    "@codemirror/state": "^6.7.6",
    "@codemirror/view": "^6.43.13",
    "@heroui/react": "^3.2.6",
    "@heroui/styles": "^3.2.6",
    "@lezer/highlight": "^1.2.5",
    "@vinext/cloudflare": "^1.0.1",
    "dompurify": "3.4.16",
    "lucide-react": "^1.49.0",
    "mermaid": "12.0.0",
    "next": "16.3.8",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-server-dom-webpack": "^19.3.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-stringify": "^10.0.1",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "remark-rehype": "^11.1.2",
    "unified": "^11.0.5",
    "vinext": "^1.0.1",
    "yaml": "^2.9.1"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "2.0.0-beta.sha-52b0dc0e9",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.7",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitejs/plugin-rsc": "^0.5.35",
    "cf": "1.0.0-beta.12",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "fake-indexeddb": "^6.2.5",
    "pdfjs-dist": "^6.5.438",
    "pdfkit": "^0.21.0",
    "pdfmake": "^0.3.15",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "8.3.0",
    "vitest": "^5.0.3"
  },
  "packageManager": "pnpm@11.18.0",
  "type": "module"
}
